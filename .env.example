# Copy this file to .env before starting the backend:
# PowerShell: Copy-Item .env.example .env
# CMD: copy .env.example .env
# Linux/macOS: cp .env.example .env
# Docker: pass .env at container runtime (for example, docker run --env-file .env).
# When the backend runs in Docker, use the database service hostname instead of localhost.
PORT=4000
NODE_ENV=development
# Defaults: API_RATE_LIMIT=2000 and AUTH_RATE_LIMIT=50 in development;
# production defaults to 300 and 10. Set these only to override the defaults.
# API_RATE_LIMIT=2000
# AUTH_RATE_LIMIT=50
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securedoc?schema=public
# Local-development placeholder only; generate a unique secret before production deployment.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
STORAGE_DIR=./storage/private
CORS_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_FRONTEND_URL=http://localhost:3000
